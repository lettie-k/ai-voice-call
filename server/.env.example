# 复制成 .env 再填。这些钥匙只放在服务器上，不要放进手机 app。

# 手机连中继用的短票据，由你的后端用同一把 secret 签（见 src/ticket.mjs）
CALL_SECRET=换成一串长随机字符

# ElevenLabs：转写 + 合成
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# STT_KEYTERMS=小星,宝宝      # 常被转错的称呼、名字，逗号隔开（几个就够）
# STT_MODEL=scribe_v3_live
# CALL_TTS_MODE=dialogue        # dialogue（v3，中文最像人）或 stream（flash，更便宜）
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# ── 模型：两种格式二选一 ──
# ① Claude 格式（默认）：Anthropic 官方，或兼容 Claude 接口的（DeepSeek、Kimi、GLM 都有这种接口）
ANTHROPIC_API_KEY=
# 或者走兼容 Anthropic 接口的中转（二选一）：
# ANTHROPIC_BASE_URL=https://openrouter.ai/api
# ANTHROPIC_AUTH_TOKEN=          # 中转给的 key（发成 Authorization: Bearer）
# CALL_MODEL=anthropic/claude-haiku-4.5   # 中转那边的型号名

# ② GPT 格式（/chat/completions）：GPT、DeepSeek、通义千问、Kimi、GLM、OpenRouter、本地 Ollama / vLLM……
# LLM_API=openai
# OPENAI_BASE_URL=https://api.openai.com/v1    # DeepSeek: https://api.deepseek.com/v1 · OpenRouter: https://openrouter.ai/api/v1 · Ollama: http://127.0.0.1:11434/v1
# OPENAI_API_KEY=                              # 本地模型可以不填
# CALL_MODEL=gpt-5.4-mini                      # 那家的型号名
# CALL_MODEL=claude-haiku-4-5    # 电话里首字要快，haiku 约 1 秒

# 人格
PERSONA_FILE=./persona.example.md

# 可选：本地听感模型（不下载就自动跳过）
# SENSE_MODEL_DIR=./models/sensevoice
# SPEAKER_MODEL_DIR=./models/speaker
# CALL_SENSE=0   # 关掉情绪那层
# CALL_VOICE=0   # 关掉声纹那层

# CALL_LANG=zh
# CALL_TZ=Asia/Shanghai
# PORT=8787
# HOST=127.0.0.1
